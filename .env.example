# Required: set strong, unique credentials before starting
PROXY_USER=change-me
PROXY_PASS=change-me
API_KEY=change-me
PROXY_PORT=8080
API_PORT=8000
HOST=0.0.0.0
ROTATION_MODE=round-robin
VALIDATION_CONCURRENCY=1000
MAX_CANDIDATES=20000
POOL_MAX_SIZE=9999
PROXY_COOLDOWN_SECONDS=3600
VALIDATION_TIMEOUT_MS=4000
ECHO_URL=https://api.ipify.org?format=json
SCRAPE_TIMEOUT_MS=10000
SCRAPE_INTERVAL_SECONDS=20
# Retire proxies whose recent success rate falls below a fraction of their initial rate
HEALTH_BASELINE_REQUESTS=5
HEALTH_WINDOW=20
HEALTH_RETENTION_RATIO=0.5
